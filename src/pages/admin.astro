---
import BaseLayout from "../layouts/BaseLayout.astro";

const appName = import.meta.env.PUBLIC_APP_NAME || "Casino Moments Admin";
---

<BaseLayout>
  <main class="admin-shell">
    <section id="loginView" class="login-view">
      <div class="ambient ambient-one"></div>
      <div class="ambient ambient-two"></div>

      <article class="access-card">
        <div class="brand-top login-brand-top">
          <div class="brand-mark image-brand">
            <img src="/logo.png" alt="Casino Moments" />
          </div>
          <div class="brand-title">
            <p class="eyebrow">Casino Moments</p>
            <h1>{appName}</h1>
          </div>
        </div>

        <div class="access-copy">
          <span class="luxury-line"></span>
          <h2>Acceso a lista de invitados</h2>
          <p>Ingresa el PIN administrador y el ID de fiesta para abrir el control de recepción.</p>
        </div>

        <div class="login-form">
          <label>
            <span>PIN administrador</span>
            <input id="adminPin" type="password" placeholder="Ingresa tu PIN" autocomplete="current-password" />
          </label>

          <label>
            <span>ID de fiesta</span>
            <input id="codigoFiesta" type="text" placeholder="Ej. CM-8F4K2" autocomplete="off" />
          </label>

          <button id="btnConsultar" class="primary-button" type="button">Entrar a la lista</button>
        </div>

        <p class="hint">El cliente debe entregar el ID generado en la app pública.</p>
        <section id="estado" class="state hidden"></section>
      </article>
    </section>

    <section id="resultado" class="dashboard-view hidden">
      <header class="dashboard-header">
        <div class="header-main">
          <div class="brand-mark image-brand header-logo">
            <img src="/logo.png" alt="Casino Moments" />
          </div>
          <div>
            <p class="eyebrow">Casino Moments</p>
            <h1>Lista de invitados</h1>
            <p class="subtitle">Consulta, búsqueda y control de asistencia para recepción.</p>
          </div>
        </div>

        <div class="header-actions">
          <button id="btnCambiarFiesta" class="ghost-button" type="button">Cambiar fiesta</button>
          <button id="btnSalir" class="ghost-button danger-button" type="button">Salir</button>
        </div>
      </header>

      <section class="event-strip">
        <div>
          <span>ID de fiesta</span>
          <strong id="resCodigo">-</strong>
        </div>
        <div>
          <span>Tipo</span>
          <strong id="tipoLista">-</strong>
        </div>
      </section>

      <div class="summary-grid">
        <article class="metric">
          <span>Registros</span>
          <strong id="totalRegistros">0</strong>
          <small>familias o responsables</small>
        </article>
        <article class="metric featured">
          <span>Total personas</span>
          <strong id="totalPersonas">0</strong>
          <small>invitados registrados</small>
        </article>
        <article class="metric">
          <span>Asistencia</span>
          <strong id="totalAsistentes">0</strong>
          <small>personas marcadas</small>
        </article>
        <article class="metric">
          <span>Pendientes</span>
          <strong id="totalPendientes">0</strong>
          <small>por confirmar entrada</small>
        </article>
      </div>

      <section class="scanner-card">
        <div class="scanner-header">
          <div>
            <p class="eyebrow">Escáner de acceso</p>
            <h2>Escanear QR</h2>
            <p>Apunta la cámara al QR del invitado para validar su acceso y marcar asistencia.</p>
          </div>

          <div class="scanner-actions">
            <button id="btnIniciarScanner" class="primary-button" type="button">Abrir cámara</button>
            <button id="btnDetenerScanner" class="ghost-button" type="button" disabled>Cerrar cámara</button>
            <button id="btnVerLista" class="secondary-button" type="button">Ver lista</button>
          </div>
        </div>

        <div id="qrReader" class="qr-reader"></div>
        <section id="qrResultado" class="scan-result hidden"></section>
      </section>

      <section id="toolsCard" class="tools-card hidden">
        <label>
          <span>Buscar invitado</span>
          <input id="buscador" type="search" placeholder="Nombre, familia, teléfono o mesa" />
        </label>
        <button id="btnExportar" class="secondary-button" type="button">Exportar CSV</button>
      </section>

      <section id="dashboardEstado" class="state dashboard-state hidden"></section>
      <section id="listaContenedor" class="list-container hidden"></section>
    </section>
  </main>

  <script>
    import { Html5Qrcode } from "html5-qrcode";

    function obtenerElemento(selector) {
      const elemento = document.querySelector(selector);

      if (!elemento) {
        throw new Error(`No se encontró el elemento ${selector}`);
      }

      return elemento;
    }

    const loginView = obtenerElemento("#loginView");
    const adminPin = obtenerElemento("#adminPin");
    const codigoFiesta = obtenerElemento("#codigoFiesta");
    const btnConsultar = obtenerElemento("#btnConsultar");
    const btnCambiarFiesta = obtenerElemento("#btnCambiarFiesta");
    const btnSalir = obtenerElemento("#btnSalir");
    const estado = obtenerElemento("#estado");
    const dashboardEstado = obtenerElemento("#dashboardEstado");
    const resultado = obtenerElemento("#resultado");
    const resCodigo = obtenerElemento("#resCodigo");
    const totalRegistros = obtenerElemento("#totalRegistros");
    const totalPersonas = obtenerElemento("#totalPersonas");
    const totalAsistentes = obtenerElemento("#totalAsistentes");
    const totalPendientes = obtenerElemento("#totalPendientes");
    const tipoLista = obtenerElemento("#tipoLista");
    const buscador = obtenerElemento("#buscador");
    const btnExportar = obtenerElemento("#btnExportar");
    const listaContenedor = obtenerElemento("#listaContenedor");
    const toolsCard = obtenerElemento("#toolsCard");
    const btnIniciarScanner = obtenerElemento("#btnIniciarScanner");
    const btnDetenerScanner = obtenerElemento("#btnDetenerScanner");
    const btnVerLista = obtenerElemento("#btnVerLista");
    const qrResultado = obtenerElemento("#qrResultado");

    let fiestaActual = null;
    let invitadosActuales = [];
    let qrScanner = null;
    let scannerActivo = false;
    let escaneoBloqueado = false;
    let listaVisible = false;

    const pinGuardado = sessionStorage.getItem("casino_admin_pin");

    if (pinGuardado) {
      adminPin.value = pinGuardado;
    }

    function mensajeDeError(error) {
      if (error instanceof Error) {
        return error.message;
      }

      return "Ocurrió un error inesperado.";
    }

    async function leerJson(response) {
      const contentType = response.headers.get("content-type") || "";

      if (!contentType.includes("application/json")) {
        throw new Error("La API no respondió con JSON válido. Revisa que la ruta exista y no esté regresando HTML.");
      }

      return await response.json();
    }

    function mostrarEstado(elemento, texto, tipo = "info") {
      elemento.textContent = texto;
      elemento.className = `state ${tipo}`;
      elemento.classList.remove("hidden");
    }

    function ocultarEstado(elemento) {
      elemento.classList.add("hidden");
    }

    function limpiarTexto(valor) {
      return String(valor || "").trim();
    }

    function normalizar(valor) {
      return limpiarTexto(valor).toLowerCase();
    }

    function escaparCsv(valor) {
      const texto = String(valor ?? "").replaceAll('"', '""');
      return `"${texto}"`;
    }

    function obtenerCantidadInvitados(invitado) {
      return Number(invitado.cantidad_invitados || 0);
    }

    function obtenerNumeroMesa(invitado) {
      if (invitado.mesa_numero !== null && invitado.mesa_numero !== undefined) {
        return Number(invitado.mesa_numero);
      }

      const match = String(invitado.mesa_nombre || "").match(/\d+/);
      return match ? Number(match[0]) : null;
    }

    function textoMesa(invitado) {
      const numero = obtenerNumeroMesa(invitado);
      return numero ? `Mesa ${numero}` : "Sin mesa";
    }


    function mostrarResultadoQr(tipo, titulo, detalle) {
      qrResultado.className = `scan-result ${tipo}`;
      qrResultado.innerHTML = "";

      const h3 = document.createElement("h3");
      h3.textContent = titulo;

      const p = document.createElement("p");
      p.textContent = detalle;

      qrResultado.append(h3, p);
      qrResultado.classList.remove("hidden");
    }

    function ocultarResultadoQr() {
      qrResultado.classList.add("hidden");
      qrResultado.innerHTML = "";
    }

    function parsearQr(textoQr) {
      const texto = limpiarTexto(textoQr);

      if (!texto) {
        return null;
      }

      // Formato recomendado: CMGUEST|CM-8F4K2|ID_INVITADO
      const partes = texto.split("|").map((parte) => limpiarTexto(parte));

      if (partes.length === 3 && partes[0].toUpperCase() === "CMGUEST") {
        return {
          codigo: partes[1].toUpperCase(),
          invitadoId: partes[2]
        };
      }

      // También acepta JSON: {"codigo":"CM-8F4K2","invitadoId":"uuid"}
      try {
        const data = JSON.parse(texto);
        return {
          codigo: limpiarTexto(data.codigo || data.fiesta).toUpperCase(),
          invitadoId: limpiarTexto(data.invitadoId || data.invitado || data.id)
        };
      } catch {
        // Continuamos para intentar con URL.
      }

      // También acepta URL con query params: ?codigo=CM-8F4K2&id=uuid
      try {
        const url = new URL(texto);
        return {
          codigo: limpiarTexto(url.searchParams.get("codigo") || url.searchParams.get("fiesta")).toUpperCase(),
          invitadoId: limpiarTexto(url.searchParams.get("invitadoId") || url.searchParams.get("invitado") || url.searchParams.get("id"))
        };
      } catch {
        return null;
      }
    }

    function mostrarDashboard() {
      loginView.classList.add("hidden");
      resultado.classList.remove("hidden");
      document.body.classList.add("dashboard-active");
    }

    function mostrarLogin(limpiarCodigo = false) {
      resultado.classList.add("hidden");
      loginView.classList.remove("hidden");
      document.body.classList.remove("dashboard-active");
      ocultarEstado(dashboardEstado);

      if (limpiarCodigo) {
        codigoFiesta.value = "";
      }

      window.setTimeout(() => codigoFiesta.focus(), 50);
    }

    function actualizarTotales() {
      const registros = invitadosActuales.length;
      const personas = invitadosActuales.reduce((suma, item) => suma + obtenerCantidadInvitados(item), 0);
      const asistentes = invitadosActuales.reduce((suma, item) => item.asistio ? suma + obtenerCantidadInvitados(item) : suma, 0);
      const pendientes = Math.max(personas - asistentes, 0);

      totalRegistros.textContent = String(registros);
      totalPersonas.textContent = String(personas);
      totalAsistentes.textContent = String(asistentes);
      totalPendientes.textContent = String(pendientes);
    }

    async function consultarLista() {
      const pin = limpiarTexto(adminPin.value);
      const codigo = limpiarTexto(codigoFiesta.value).toUpperCase();

      if (!pin) {
        mostrarEstado(estado, "Escribe el PIN de administrador.", "error");
        adminPin.focus();
        return;
      }

      if (!codigo) {
        mostrarEstado(estado, "Escribe el ID de fiesta.", "error");
        codigoFiesta.focus();
        return;
      }

      sessionStorage.setItem("casino_admin_pin", pin);
      btnConsultar.disabled = true;
      btnConsultar.textContent = "Validando acceso...";
      mostrarEstado(estado, "Buscando lista de invitados...", "info");

      try {
        const response = await fetch(`/api/fiestas/${encodeURIComponent(codigo)}`, {
          headers: {
            "x-admin-pin": pin
          }
        });

        const data = await leerJson(response);

        if (!response.ok || !data.ok) {
          throw new Error(data.message || "No se pudo consultar la lista.");
        }

        fiestaActual = data.fiesta;
        invitadosActuales = Array.isArray(data.invitados) ? data.invitados : [];
        resCodigo.textContent = fiestaActual.codigo;
        tipoLista.textContent = fiestaActual.usa_mesas ? "Con mesas" : "Lista general";
        buscador.value = "";
        actualizarTotales();
        renderizarLista();

        listaVisible = false;
        toolsCard.classList.add("hidden");
        listaContenedor.classList.add("hidden");
        btnVerLista.textContent = "Ver lista";
        ocultarResultadoQr();

        ocultarEstado(estado);
        mostrarDashboard();
      } catch (error) {
        resultado.classList.add("hidden");
        mostrarEstado(estado, mensajeDeError(error), "error");
      } finally {
        btnConsultar.disabled = false;
        btnConsultar.textContent = "Entrar a la lista";
      }
    }

    function obtenerFiltrados() {
      const q = normalizar(buscador.value);

      if (!q) {
        return invitadosActuales;
      }

      return invitadosActuales.filter((invitado) => {
        const numeroMesa = obtenerNumeroMesa(invitado);
        const texto = [
          invitado.nombre,
          invitado.telefono,
          invitado.mesa_nombre,
          numeroMesa ? `mesa ${numeroMesa}` : "sin mesa",
          invitado.cantidad_invitados,
          invitado.asistio ? "asistió" : "pendiente"
        ].join(" ").toLowerCase();

        return texto.includes(q);
      });
    }

    function agruparPorMesa(invitados) {
      const grupos = new Map();

      for (const invitado of invitados) {
        const mesa = textoMesa(invitado);

        if (!grupos.has(mesa)) {
          grupos.set(mesa, []);
        }

        grupos.get(mesa).push(invitado);
      }

      return [...grupos.entries()].sort((a, b) => {
        const numeroA = obtenerNumeroMesa(a[1][0]) ?? 999999;
        const numeroB = obtenerNumeroMesa(b[1][0]) ?? 999999;

        if (numeroA !== numeroB) {
          return numeroA - numeroB;
        }

        return a[0].localeCompare(b[0], "es");
      });
    }

    function crearFila(invitado) {
      const fila = document.createElement("div");
      fila.className = `guest-row ${invitado.asistio ? "checked" : ""}`;

      const avatar = document.createElement("div");
      avatar.className = "guest-avatar";
      avatar.textContent = limpiarTexto(invitado.nombre).slice(0, 1).toUpperCase() || "?";

      const info = document.createElement("div");
      info.className = "guest-info";

      const nombre = document.createElement("strong");
      nombre.textContent = invitado.nombre || "Sin nombre";

      const meta = document.createElement("p");
      const telefono = invitado.telefono || "Sin teléfono";
      const capacidad = invitado.mesa_capacidad ? ` · ${invitado.mesa_capacidad} pers. por mesa` : "";
      meta.textContent = `${telefono} · ${obtenerCantidadInvitados(invitado)} invitado(s)${capacidad}`;

      info.append(nombre, meta);

      const actions = document.createElement("div");
      actions.className = "guest-actions";

      const mesaBadge = document.createElement("span");
      mesaBadge.className = obtenerNumeroMesa(invitado) ? "mesa-badge" : "mesa-badge no-mesa";
      mesaBadge.textContent = textoMesa(invitado);

      const estadoAsistencia = document.createElement("span");
      estadoAsistencia.className = `status ${invitado.asistio ? "ok" : "pending"}`;
      estadoAsistencia.textContent = invitado.asistio ? "Asistió" : "Pendiente";

      const boton = document.createElement("button");
      boton.type = "button";
      boton.className = "small-button";
      boton.textContent = invitado.asistio ? "Quitar" : "Marcar";
      boton.addEventListener("click", () => cambiarAsistencia(invitado.id, !invitado.asistio));

      actions.append(mesaBadge, estadoAsistencia, boton);
      fila.append(avatar, info, actions);
      return fila;
    }

    function renderizarLista() {
      const invitados = obtenerFiltrados();
      listaContenedor.innerHTML = "";

      if (!invitados.length) {
        const vacio = document.createElement("section");
        vacio.className = "empty-card";
        vacio.textContent = "No hay invitados que coincidan con la búsqueda.";
        listaContenedor.append(vacio);
        return;
      }

      if (fiestaActual?.usa_mesas) {
        const grupos = agruparPorMesa(invitados);

        for (const [mesa, lista] of grupos) {
          const seccion = document.createElement("section");
          seccion.className = "group-card";

          const header = document.createElement("div");
          header.className = "group-header";

          const titulo = document.createElement("h2");
          titulo.textContent = mesa;

          const total = document.createElement("span");
          const totalPersonasMesa = lista.reduce((suma, item) => suma + obtenerCantidadInvitados(item), 0);
          total.textContent = `${totalPersonasMesa} personas`;

          header.append(titulo, total);
          seccion.append(header);

          for (const invitado of lista) {
            seccion.append(crearFila(invitado));
          }

          listaContenedor.append(seccion);
        }

        return;
      }

      const seccion = document.createElement("section");
      seccion.className = "group-card";

      const header = document.createElement("div");
      header.className = "group-header";

      const titulo = document.createElement("h2");
      titulo.textContent = "Lista general";

      const total = document.createElement("span");
      const totalPersonasLista = invitados.reduce((suma, item) => suma + obtenerCantidadInvitados(item), 0);
      total.textContent = `${totalPersonasLista} personas`;

      header.append(titulo, total);
      seccion.append(header);

      for (const invitado of invitados) {
        seccion.append(crearFila(invitado));
      }

      listaContenedor.append(seccion);
    }

    async function cambiarAsistencia(id, asistio) {
      const pin = limpiarTexto(adminPin.value);
      ocultarEstado(dashboardEstado);

      try {
        const response = await fetch(`/api/invitados/${encodeURIComponent(String(id))}/asistencia`, {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
            "x-admin-pin": pin
          },
          body: JSON.stringify({ asistio })
        });

        const data = await leerJson(response);

        if (!response.ok || !data.ok) {
          throw new Error(data.message || "No se pudo actualizar la asistencia.");
        }

        invitadosActuales = invitadosActuales.map((item) => item.id === id ? { ...item, asistio } : item);
        actualizarTotales();
        renderizarLista();
        return true;
      } catch (error) {
        mostrarEstado(dashboardEstado, mensajeDeError(error), "error");
        return false;
      }
    }

    async function procesarQr(textoQr) {
      if (escaneoBloqueado) {
        return;
      }

      escaneoBloqueado = true;

      try {
        const datosQr = parsearQr(textoQr);

        if (!datosQr || !datosQr.codigo || !datosQr.invitadoId) {
          mostrarResultadoQr(
            "rechazado",
            "QR inválido",
            "Este código no pertenece al sistema de Casino Moments."
          );
          return;
        }

        if (!fiestaActual) {
          mostrarResultadoQr(
            "rechazado",
            "Sin fiesta cargada",
            "Primero inicia sesión con el ID de fiesta."
          );
          return;
        }

        if (datosQr.codigo !== fiestaActual.codigo) {
          mostrarResultadoQr(
            "rechazado",
            "QR de otra fiesta",
            `Este QR pertenece a ${datosQr.codigo}, pero estás en ${fiestaActual.codigo}.`
          );
          return;
        }

        const invitado = invitadosActuales.find(
          (item) => String(item.id) === String(datosQr.invitadoId)
        );

        if (!invitado) {
          mostrarResultadoQr(
            "rechazado",
            "No autorizado",
            "Este invitado no está en la lista de esta fiesta."
          );
          return;
        }

        const mesa = textoMesa(invitado);
        const nombre = invitado.nombre || "Familia sin nombre";

        if (invitado.asistio) {
          mostrarResultadoQr(
            "advertencia",
            "Ya estaba registrado",
            `${nombre} · ${mesa}`
          );
          return;
        }

        const actualizado = await cambiarAsistencia(invitado.id, true);

        if (!actualizado) {
          mostrarResultadoQr(
            "rechazado",
            "No se pudo marcar asistencia",
            "Intenta escanear de nuevo o busca al invitado manualmente."
          );
          return;
        }

        mostrarResultadoQr(
          "aprobado",
          "Aprobado",
          `${nombre} · ${mesa}`
        );
      } finally {
        window.setTimeout(() => {
          escaneoBloqueado = false;
        }, 1800);
      }
    }

    async function iniciarScanner() {
      if (!fiestaActual) {
        mostrarResultadoQr(
          "rechazado",
          "Sin fiesta cargada",
          "Primero ingresa con PIN administrador e ID de fiesta."
        );
        return;
      }

      if (scannerActivo) {
        return;
      }

      ocultarResultadoQr();

      try {
        if (!qrScanner) {
          qrScanner = new Html5Qrcode("qrReader");
        }

        await qrScanner.start(
          { facingMode: "environment" },
          {
            fps: 10,
            qrbox: {
              width: 260,
              height: 260
            }
          },
          (decodedText) => {
            procesarQr(decodedText);
          },
          () => {
            // Ignoramos lecturas fallidas para no llenar la pantalla de errores.
          }
        );

        scannerActivo = true;
        btnIniciarScanner.disabled = true;
        btnDetenerScanner.disabled = false;
      } catch (error) {
        mostrarResultadoQr(
          "rechazado",
          "No se pudo abrir la cámara",
          mensajeDeError(error)
        );
      }
    }

    async function detenerScanner() {
      if (!qrScanner || !scannerActivo) {
        return;
      }

      try {
        await qrScanner.stop();
        await qrScanner.clear();
      } catch {
        // No bloqueamos la interfaz si la cámara ya estaba cerrada.
      }

      scannerActivo = false;
      btnIniciarScanner.disabled = false;
      btnDetenerScanner.disabled = true;
    }

    function alternarLista() {
      listaVisible = !listaVisible;

      if (listaVisible) {
        toolsCard.classList.remove("hidden");
        listaContenedor.classList.remove("hidden");
        btnVerLista.textContent = "Ocultar lista";
        renderizarLista();
        buscador.focus();
      } else {
        toolsCard.classList.add("hidden");
        listaContenedor.classList.add("hidden");
        btnVerLista.textContent = "Ver lista";
        buscador.value = "";
      }
    }

    function exportarCsv() {
      if (!fiestaActual) {
        return;
      }

      const invitados = obtenerFiltrados();
      const encabezados = ["ID Fiesta", "Nombre", "Teléfono", "Cantidad", "Número mesa", "Mesa", "Personas por mesa", "Asistió"];
      const filas = invitados.map((invitado) => [
        fiestaActual?.codigo || "",
        invitado.nombre || "",
        invitado.telefono || "",
        obtenerCantidadInvitados(invitado),
        obtenerNumeroMesa(invitado) || "",
        invitado.mesa_nombre || "",
        invitado.mesa_capacidad || "",
        invitado.asistio ? "Sí" : "No"
      ]);

      const csv = [encabezados, ...filas]
        .map((fila) => fila.map(escaparCsv).join(","))
        .join("\n");

      const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `lista-${fiestaActual.codigo}.csv`;
      document.body.append(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    }

    async function salir() {
      await detenerScanner();

      sessionStorage.removeItem("casino_admin_pin");
      adminPin.value = "";
      codigoFiesta.value = "";
      fiestaActual = null;
      invitadosActuales = [];
      listaContenedor.innerHTML = "";

      listaVisible = false;
      toolsCard.classList.add("hidden");
      listaContenedor.classList.add("hidden");
      btnVerLista.textContent = "Ver lista";
      ocultarResultadoQr();

      mostrarLogin(true);
    }

    btnConsultar.addEventListener("click", consultarLista);
    btnCambiarFiesta.addEventListener("click", async () => {
      await detenerScanner();
      mostrarLogin(true);
    });
    btnSalir.addEventListener("click", salir);
    btnIniciarScanner.addEventListener("click", iniciarScanner);
    btnDetenerScanner.addEventListener("click", detenerScanner);
    btnVerLista.addEventListener("click", alternarLista);
    codigoFiesta.addEventListener("input", () => {
      codigoFiesta.value = codigoFiesta.value.toUpperCase();
    });
    codigoFiesta.addEventListener("keydown", (event) => {
      if (event.key === "Enter") consultarLista();
    });
    adminPin.addEventListener("keydown", (event) => {
      if (event.key === "Enter") consultarLista();
    });
    buscador.addEventListener("input", renderizarLista);
    btnExportar.addEventListener("click", exportarCsv);
  </script>
</BaseLayout>
